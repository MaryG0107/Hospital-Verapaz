# Servidor
PORT=4000

# Base de datos (PostgreSQL) -- pendiente de definir host (local vs. nube)
DATABASE_URL=postgresql://usuario:password@localhost:5432/hospital_verapaz

# Autenticacion
JWT_SECRET=cambiar_este_valor
JWT_EXPIRES_IN=8h

# Tokens de acceso temporal (RF-33, RF-34)
TEMP_TOKEN_EXPIRES_MIN=15

# Cifrado del diagnostico clinico (RF-10). Debe ser una llave de 32 bytes en hexadecimal (64 caracteres).
# Generarla con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=cambiar_por_64_caracteres_hexadecimales

# Usuario administrador inicial (usado por prisma/seed.js)
SEED_ADMIN_EMAIL=admin@hospitalverapaz.gt
SEED_ADMIN_PASSWORD=CambiarEsta123
